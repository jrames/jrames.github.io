 "signatures": [],
 "picks": [
  {
   "id": "egg-nog",
   "name": "McCallister Christmas Eve",
   "blurb": "Brandy and milk for the night the family packs for Paris and the whole house tilts into holiday chaos."
  },
  {
   "id": "hot-brandy-sling",
   "name": "Suburban Power Outage",
   "blurb": "Hot water and brandy warm you through the blown alarm clocks and the dark Chicago-suburb morning."
  },
  {
   "id": "tom-and-jerry",
   "name": "Attic Aftermath",
   "blurb": "Rum and batter turn the attic sulk into a frothy Christmas grumble, sweet enough for a truce."
  },
  {
   "id": "mulled-claret",
   "name": "Paris Departure Evening",
   "blurb": "Lemons and mulling spice keep this red-wine pour busy while the family scrambles for an international getaway."
  },
  {
   "id": "whiskey-sour",
   "name": "Thrown-Out Ticket",
   "blurb": "Bourbon and lemon come sharp, like a plane ticket tossed out with the spilled milk while nobody counts heads."
  },
  {
   "id": "manhattan",
   "name": "Empty House Morning",
   "blurb": "Rye brings a dry, grown-up edge to Kevin waking up alone in the McCallister house."
  },
  {
   "id": "americano",
   "name": "Wet Bandits Watch",
   "blurb": "Campari and vermouth stay brisk and red, just right for burglars hovering outside a supposedly occupied home."
  },
  {
   "id": "bloody-mary",
   "name": "Airport Layover Scramble",
   "blurb": "Tomato, spice, and salt keep their nerve while the trip to Chicago detours through Dallas and Scranton."
  },
  {
   "id": "kir",
   "name": "Paris Apartment Pause",
   "blurb": "Crème de cassis sweetens the wait in Peter's brother's apartment, where nobody is getting home quickly."
  },
  {
   "id": "bellini",
   "name": "Christmas Eve Plans",
   "blurb": "Sparkling wine and peach make a light diversion from all that packing, panic, and booked-up flights."
  },
  {
   "id": "mojito",
   "name": "Shoveling Neighbor",
   "blurb": "Fresh mint for the snowy street and the old neighbor with the shovel that every kid on the block whispers about."
  },
  {
   "id": "clover-leaf",
   "name": "Church Choir Visit",
   "blurb": "Gin, berry, and egg white soften the bitter edge of the church scene and that choir in winter light."
  },
  {
   "id": "bramble",
   "name": "Old Man Marley",
   "blurb": "Gin and berry syrup land with a tart surprise for the fence-line talks and the rumors around Marley."
  },
  {
   "id": "new-york-sour",
   "name": "Polka Band Ride",
   "blurb": "A red wine float gives the long drive west to Chicago some swagger, even riding with a polka band."
  },
  {
   "id": "pimms-cup",
   "name": "Christmas Return Route",
   "blurb": "Cucumber and strawberries sound odd, but so does riding from Scranton to Chicago in a van full of polka musicians."
  }
 ],
