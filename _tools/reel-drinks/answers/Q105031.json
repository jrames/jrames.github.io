 "signatures": [],
 "picks": [
  {
   "id": "mulled-claret",
   "name": "Snowed-In Windowpanes",
   "blurb": "Hot red wine and spices warm up a Chicago house when the temperature outside is doing its best to be rude."
  },
  {
   "id": "cape-codder",
   "name": "Red Sweater Mailbox",
   "blurb": "Cranberry tartness keeps things bright, like that suburban front lawn under fresh snow and too much holiday cheer."
  },
  {
   "id": "moscow-mule",
   "name": "Basement Trolley Dash",
   "blurb": "Ginger bite and lime snap through the cold the way a mad sprint across an overstuffed house should."
  },
  {
   "id": "whiskey-sour",
   "name": "Toy Train Tension",
   "blurb": "Lemons and whiskey bring a sharp little jolt, which is exactly what your nerves want before the next household ambush."
  },
  {
   "id": "bellini",
   "name": "Paris Departure Gate",
   "blurb": "Sparkling wine and peach keep it light for a quick getaway from one airport into another city entirely."
  },
  {
   "id": "cuba-libre",
   "name": "Wet Bandits Escape",
   "blurb": "Cola and rum roll along easy, then sneak up on you like a bad plan with a lot of momentum."
  },
  {
   "id": "clover-club",
   "name": "Pinecone Trap Room",
   "blurb": "Raspberry foam softens the edges, though the first sip still lands with the same ridiculous precision as a booby trap."
  },
  {
   "id": "manhattan",
   "name": "Holiday Night Watch",
   "blurb": "Rye and vermouth come dressed sharp, for the kid who has to act older than the adults around him."
  },
  {
   "id": "paloma",
   "name": "Blue House Silence",
   "blurb": "Grapefruit and tequila stay brisk and bright, which is more than can be said for that suddenly empty house."
  },
  {
   "id": "new-york-sour",
   "name": "Upstairs Loft Ledger",
   "blurb": "A red wine cap over bourbon gives you a neat split between sweet comfort and the sting of being left alone."
  },
  {
   "id": "corpse-reviver-2",
   "name": "Kitchen Counter Scheme",
   "blurb": "Gin, lemon, and absinthe wake everything up fast, useful when the adults are somewhere else and trouble isn't."
  },
  {
   "id": "jack-rose",
   "name": "Wrapped Parcel Panic",
   "blurb": "Apple brandy and grenadine bring a shiny red sweetness that sneaks in right before the next disaster drops."
  },
  {
   "id": "tom-collins",
   "name": "Driveway Snow Track",
   "blurb": "Gin, lemon, and soda keep moving cleanly, like a sled run that starts with confidence and ends in chaos."
  },
  {
   "id": "kingston-club",
   "name": "Christmas Tree Fort",
   "blurb": "Pineapple, honey, and Drambuie make a sweet, stubborn shelter for anyone plotting from behind the branches."
  },
  {
   "id": "americano",
   "name": "Suburban Porch Patrol",
   "blurb": "Campari and vermouth stay lightly bitter and fizzy, for the grown-up who should probably be home instead of wandering."
  }
 ],
