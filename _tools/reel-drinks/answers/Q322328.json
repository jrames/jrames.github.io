 "signatures": [],
 "picks": [
  {
   "id": "orange-whip",
   "name": "Christmas Town Whimsy",
   "blurb": "Creamy orange and rum for Jack’s first dazzled walk through Christmas Town; sugar never looked so suspicious."
  },
  {
   "id": "hot-buttered-rum",
   "name": "Coffin Sleigh Night",
   "blurb": "Butter and dark rum warm the chill after Jack sends his skeletal reindeer into the winter sky."
  },
  {
   "id": "hot-oaxacan-penicillin",
   "name": "Forest Door Crossing",
   "blurb": "Smoky tequila and mezcal suit the circle of doors, when one wrong turn opens into holiday trouble."
  },
  {
   "id": "golden-dream",
   "name": "Sandy Claws Report",
   "blurb": "Orange cream and Galliano make a too-sweet broadcast for the Mayor, who still can’t explain what Jack has done."
  },
  {
   "id": "el-diablo",
   "name": "Halloween Town Parade",
   "blurb": "Purple cassis and ginger beer bring the pageant colors of Halloween Town, where every celebration leans a little wicked."
  },
  {
   "id": "smoking-bishop",
   "name": "Cemetery Landing",
   "blurb": "Port, lemons, and spice warm the crash site; Jack survives the fall, and the graveyard keeps its manners."
  },
  {
   "id": "bees-knees",
   "name": "Sally’s Warning",
   "blurb": "Honey and lemon keep Sally sharp while she tries to stop Jack from turning Christmas into chaos."
  },
  {
   "id": "moscow-mule",
   "name": "Lock Shock Barrel",
   "blurb": "Ginger beer snaps like those trick-or-treating troublemakers, always one bad idea ahead of Jack."
  },
  {
   "id": "penicillin",
   "name": "Oogie’s Game",
   "blurb": "Smoky Scotch and ginger bite back as Oogie Boogie turns gambling into a nasty little holiday game."
  },
  {
   "id": "aperol-spritz",
   "name": "Mayor’s Announcement",
   "blurb": "Bubbly and orange, this one rattles along like the Mayor’s public news about Jack’s supposed end."
  },
  {
   "id": "tom-and-jerry",
   "name": "Finkelstein’s Workshop",
   "blurb": "Creamy batter and rum feel stitched together by Doctor Finkelstein’s workshop, where strange plans get built indoors."
  },
  {
   "id": "naked-and-famous",
   "name": "Christmas Town Spark",
   "blurb": "Mezcal and Aperol make a bright, oddball jolt for the moment Jack realizes another holiday exists."
  },
  {
   "id": "rusty-nail",
   "name": "Pumpkin King Return",
   "blurb": "Scotch and Drambuie bring a stern, wintry edge when Jack comes back from the cemetery wiser than before."
  },
  {
   "id": "bloody-mary",
   "name": "Halloween Town Alarm",
   "blurb": "Tomato, spice, and vodka sound like locked doors and panic after the Halloween gifts terrify the real world."
  },
  {
   "id": "mulled-claret",
   "name": "Winter Door Hall",
   "blurb": "Red wine with mulling spices wanders warmly through the holiday doors, all spice and no good judgment."
  }
 ],
