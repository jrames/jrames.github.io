 "signatures": [],
 "picks": [
  {
   "id": "new-york-sour",
   "name": "Plaza After Midnight",
   "blurb": "That red wine top is for the elevator shafts, the bloodless snow, and one long bad night in downtown L.A."
  },
  {
   "id": "old-fashioned",
   "name": "Christmas Party Floor",
   "blurb": "Bourbon keeps the whole mess upright, like a tie loosened after the office party went sideways."
  },
  {
   "id": "manhattan",
   "name": "Skyscraper Lobby Lights",
   "blurb": "Rye and vermouth bring sharp edges for the marble corridors and all that glass under holiday decorations."
  },
  {
   "id": "boulevardier",
   "name": "Vent Shaft Smoke",
   "blurb": "Campari gives this one a bruised bite, handy for every crawl through concrete, dust, and bad decisions."
  },
  {
   "id": "sazerac",
   "name": "Thirty-Eighth Floor",
   "blurb": "Absinthe and rye cut clean as broken windows when the night keeps climbing higher."
  },
  {
   "id": "negroni",
   "name": "Radio Silence Break",
   "blurb": "Gin, Campari, and vermouth stay stern while the building turns into a Christmas wreck."
  },
  {
   "id": "moscow-mule",
   "name": "Garage Floor Frost",
   "blurb": "Ginger beer snaps like a cold concrete landing, and that lime keeps the whole thing moving fast."
  },
  {
   "id": "bloody-mary",
   "name": "Desk Drawer Remedy",
   "blurb": "Tomato, spice, and salt come on like a busted lip after too many hours trapped inside."
  },
  {
   "id": "tom-and-jerry",
   "name": "Holiday Office Ransack",
   "blurb": "Hot batter and rum warm the bones while the tower fills with smoke, panic, and shredded wrapping paper."
  },
  {
   "id": "j-tonys-kold-brew-americano",
   "name": "Night Shift Coffee",
   "blurb": "Coffee and Campari taste like fluorescent lights, radio chatter, and a Christmas Eve with no mercy."
  },
  {
   "id": "red-morning-light",
   "name": "Rooftop Dawn Watch",
   "blurb": "Coffee-chocolate notes hit like the first weak light after a long siege on the top floors."
  },
  {
   "id": "blood-and-sand",
   "name": "Broken Ornament Box",
   "blurb": "Cherry and orange soften the Scotch just enough for a holiday gone sharp around the edges."
  },
  {
   "id": "vieux-carre",
   "name": "Service Corridor Stash",
   "blurb": "Rye, cognac, and bitters carry more heat than the air ducts, which is saying something."
  },
  {
   "id": "winterized-negroni",
   "name": "Ventilation Crawlspace",
   "blurb": "Peated Scotch adds a smoky edge that hangs around like dust in the ducts and a bad plan."
  },
  {
   "id": "paper-plane",
   "name": "Parking Garage Escape",
   "blurb": "Bourbon and amaro give this sour a sprinting finish, same energy as a getaway through the concrete levels."
  }
 ],
