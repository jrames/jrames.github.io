 "signatures": [],
 "picks": [
  {
   "id": "hot-brandy-sling",
   "name": "Smeerensburg Night Run",
   "blurb": "Hot brandy and sugar make a decent warming kit for Jesper’s snowy delivery runs across that lonely island town."
  },
  {
   "id": "mulled-claret",
   "name": "Island Letterfire",
   "blurb": "Spiced red wine suits the red-and-white Christmas push and the town’s long, frosty evenings."
  },
  {
   "id": "hot-toddy",
   "name": "Klaus Cabin Fire",
   "blurb": "Honeyed whiskey keeps the cold out while Klaus guards his toy workshop far from Smeerensburg."
  },
  {
   "id": "egg-nog",
   "name": "Lydia Keepsake Table",
   "blurb": "Creamy and old-fashioned, this one lingers like Klaus’s memories of Lydia and the children they hoped for."
  },
  {
   "id": "irish-coffee",
   "name": "Post Office Dawn",
   "blurb": "Coffee, cream, and whiskey for a clerk who has letters to chase before the snow shuts everything down."
  },
  {
   "id": "tom-and-jerry",
   "name": "Toy Workshop Steam",
   "blurb": "Foamy batter and rum bring the kind of old winter warmth that belongs beside carved toys and candlelight."
  },
  {
   "id": "smoking-bishop",
   "name": "Northern Harbor Banter",
   "blurb": "Port and spice give Smeerensburg’s feuding clans something richer than spite to keep them talking."
  },
  {
   "id": "brandy-rickey",
   "name": "Sled-Building Day",
   "blurb": "Brandy with lime and soda keeps the pace brisk, like Jesper and Klaus finishing that sled together."
  },
  {
   "id": "manhattan",
   "name": "Postal Academy Brass",
   "blurb": "Rye and vermouth come dressed for authority, which is exactly the sort of confidence Jesper keeps faking."
  },
  {
   "id": "kir",
   "name": "Schoolroom Reopening",
   "blurb": "White wine and cassis turn plain paper and hard lessons into something the children might actually send."
  },
  {
   "id": "ramos-fizz",
   "name": "Snowfall Letters",
   "blurb": "Creamy gin and bubbles give the letter-writing scramble a soft white head, like fresh snow on the island."
  },
  {
   "id": "new-york-sour",
   "name": "Toy Drawing Night",
   "blurb": "That red wine float looks as sly as Jesper slipping a secret toy into the dark."
  },
  {
   "id": "paloma",
   "name": "Smeerensburg Sled Pull",
   "blurb": "Grapefruit and salt cut through the winter bite, useful when everybody’s dragging a sled through the snow."
  },
  {
   "id": "clover-club",
   "name": "Kindness Ledger",
   "blurb": "Raspberry and egg white make a pink little truce, better than clan grudges and much easier to swallow."
  },
  {
   "id": "blood-and-sand",
   "name": "Christmas Turning Point",
   "blurb": "Scotch and orange bring a bittersweet edge, which is what happens when the town finally starts changing."
  }
 ],
 "cuts": []
}
