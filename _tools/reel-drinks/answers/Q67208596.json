 "picks": [
  {
   "id": "egg-nog",
   "name": "Snowy Attic Letters",
   "blurb": "Custard-thick and sweet, like sorting good deeds by lamplight while the whole town pretends not to need help."
  },
  {
   "id": "hot-brandy-sling",
   "name": "Harbor Bell Evening",
   "blurb": "Brandy warmed straight through the chill, for the moment when the sleigh bells start sounding over the dockside roofs."
  },
  {
   "id": "french-75",
   "name": "Midnight Rooftop Run",
   "blurb": "Bubbles and lemon keep this one moving fast, just like a snowy dash across chimney tops and down narrow streets."
  },
  {
   "id": "mulled-claret",
   "name": "Market Square Lanterns",
   "blurb": "Spiced red wine brings the whole square indoors, where everyone is thawing out and still acting suspicious."
  },
  {
   "id": "tom-and-jerry",
   "name": "Workroom Hearth Bowl",
   "blurb": "Creamy rum and spice suit a hand-built winter miracle, especially when the night turns into one long repair job."
  },
  {
   "id": "pina-colada",
   "name": "Polar Sleigh Surprise",
   "blurb": "Creamy and playful, with enough tropical nonsense to cheer up a town that forgot how to smile."
  },
  {
   "id": "penicillin",
   "name": "Frozen Dockside Smoke",
   "blurb": "Honey, ginger, and a little peat cut through the cold like a stubborn lantern on an empty pier."
  },
  {
   "id": "ramos-fizz",
   "name": "Snow Globe Parlor",
   "blurb": "Foamy gin and orange blossom make everything look polished, even when the shop floor is chaos and sawdust."
  },
  {
   "id": "hot-toddy",
   "name": "Late Chimney Check",
   "blurb": "Honeyed whiskey is what you want after a night of rooftops, ropes, and regrettable weather choices."
  },
  {
   "id": "planters-punch",
   "name": "Postbag At Dusk",
   "blurb": "Dark rum keeps this punch practical, which is more than can be said for the mail route at first light."
  },
  {
   "id": "corpse-reviver-2",
   "name": "Blue Envelope Return",
   "blurb": "Bright citrus and a sly absinthe edge wake you up fast, like finding one last note after the room goes quiet."
  },
  {
   "id": "moscow-mule",
   "name": "Sledge Runner",
   "blurb": "Ginger bite and lime snap through the frost, all steel nerves and skidding runners on packed snow."
  },
  {
   "id": "whiskey-sour",
   "name": "Town Hall Standoff",
   "blurb": "Sharp, no-nonsense whiskey for a room full of stubborn people who only thaw after the argument ends."
  },
  {
   "id": "brandy-and-soda",
   "name": "Winter Harbor Window",
   "blurb": "Clean and simple, with enough sparkle to keep you watching the snow instead of the clock."
  },
  {
   "id": "mojito",
   "name": "Green Workshop Sprig",
   "blurb": "Mint lifts the whole thing off the table, useful when the only thing greener than the garlands is the town’s attitude."
  }
