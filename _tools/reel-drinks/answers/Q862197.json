 "signatures": [],
 "picks": [
  {
   "id": "tom-and-jerry",
   "name": "Train Car Custard",
   "blurb": "Eggnog's rowdy cousin warms you from the platform to the caboose, with enough spice for every frosted window."
  },
  {
   "id": "hot-buttered-rum",
   "name": "Cabin Heat Stop",
   "blurb": "Butter and rum steam up like the dining car after midnight, when the snow outside starts acting dramatic."
  },
  {
   "id": "hot-toddy",
   "name": "Bell-Quiet Break",
   "blurb": "Honeyed whiskey suits the hush between stations, when the white world outside keeps moving and nobody wants to."
  },
  {
   "id": "japanese-highball",
   "name": "Silver Track Night",
   "blurb": "This lean whisky lift keeps the ride crisp, like moonlight on rails and every polished seatback."
  },
  {
   "id": "bees-knees",
   "name": "Ticket Pocket Treat",
   "blurb": "Honey and lemon make a bright little reward for the kid still clutching that ticket like it matters."
  },
  {
   "id": "moscow-mule",
   "name": "Frosted Window Kick",
   "blurb": "Ginger beer snaps like ice on the glass, while the vodka keeps the whole trip brisk and awake."
  },
  {
   "id": "irish-whiskey-ginger-lime",
   "name": "Snowbank Platform",
   "blurb": "Lime and ginger cut through the cold as neatly as boots through fresh snow beside the tracks."
  },
  {
   "id": "aged-rum-ginger-lime",
   "name": "Caboose Lantern Run",
   "blurb": "Dark rum with ginger ale brings amber warmth, the sort you want after racing past blue-black trees."
  },
  {
   "id": "golden-dream",
   "name": "Snow Globe Dessert",
   "blurb": "Creamy orange and herb sweetness land like a sugar-dusted finale, ridiculous in the best holiday way."
  },
  {
   "id": "sazerac",
   "name": "Engineer’s Nightcap",
   "blurb": "Rye, bitters, and absinthe feel sharp enough for the engine room, even if you're only watching from home."
  },
  {
   "id": "old-fashioned",
   "name": "Conductor's Corner",
   "blurb": "A straight bourbon build keeps things proper and sturdy, like a grown-up answering the call of the whistle."
  },
  {
   "id": "hot-brandy-sling",
   "name": "Amber Lamp Stop",
   "blurb": "Brandy and hot water bring plain old warmth, the kind that makes snowy windows look less bossy."
  },
  {
   "id": "mulled-claret",
   "name": "Midnight Cocoa Red",
   "blurb": "Spiced wine leans festive and a little old-world, perfect for a night when the dark gets cheerful."
  },
  {
   "id": "canchanchara",
   "name": "North Pole Sip",
   "blurb": "Honey, lime, and rum keep it simple and bright, like a bell that still sounds believable."
  },
  {
   "id": "whiskey-sour",
   "name": "Blue Seat Moment",
   "blurb": "Lemon keeps this one clean and bright, a sharp little pause before the train plunges back into winter."
  }
 ],
 "cuts": []
}
