 "signatures": [],
 "picks": [
  {
   "id": "egg-nog",
   "name": "North Pole Nog",
   "blurb": "Creamy and celebratory, like that first ride to the North Pole when Christmas Eve suddenly gets serious."
  },
  {
   "id": "hot-buttered-rum",
   "name": "Observation Car Warmth",
   "blurb": "Butter and rum keep the chill off while the observation car rolls along and everybody pretends this trip is normal."
  },
  {
   "id": "verte-chaud",
   "name": "Hot Chocolate Stop",
   "blurb": "Green Chartreuse sneaks into the cocoa, a sly little jolt for the hot chocolate scene and its white winter steam."
  },
  {
   "id": "hot-toddy",
   "name": "Frozen Lake Toddy",
   "blurb": "Honeyed whiskey steadies you better than the throttle ever did on that frozen lake stretch."
  },
  {
   "id": "smoking-bishop",
   "name": "Christmas Eve Bishop",
   "blurb": "Port and spices come dressed for snow, which is more than you can say for a boy doubting Santa on Christmas Eve."
  },
  {
   "id": "tom-and-jerry",
   "name": "Conductor's Cocoa Rush",
   "blurb": "Rich, foamy, and a little old-fashioned, just like the train kitchen when hot chocolate starts running the show."
  },
  {
   "id": "hot-brandy-sling",
   "name": "Headlamp in the Dark",
   "blurb": "Brandy and hot water shine amber, like the engine's light cutting the long dark between Grand Rapids and the North Pole."
  },
  {
   "id": "irish-coffee",
   "name": "Caribou Crossing Coffee",
   "blurb": "Coffee, cream, and whiskey keep the pace up when the train meets that herd of caribou."
  },
  {
   "id": "aged-rum-ginger-lime",
   "name": "Ticket Chase Sprint",
   "blurb": "Ginger and lime snap forward fast, like a missing ticket skittering through the cold and refusing to stay lost."
  },
  {
   "id": "bourbon-collins",
   "name": "First Gift of Christmas",
   "blurb": "Bright lemon and soda ring clean as the sleigh bell Santa hands the boy, the first gift of Christmas."
  },
  {
   "id": "japanese-highball",
   "name": "Steel Rail Highball",
   "blurb": "Straight whiskey and soda whistle past like rails under a train headed somewhere impossible."
  },
  {
   "id": "moscow-mule",
   "name": "Northbound Mule",
   "blurb": "Ginger beer gives this one a bracing kick for sleigh bells, snow, and all that midnight motion."
  },
  {
   "id": "blue-hawaii",
   "name": "Winter Night Blue",
   "blurb": "Blue as the dark outside the windows, with enough tropical nonsense to make the Polar Express grin."
  },
  {
   "id": "hot-oaxacan-penicillin",
   "name": "Engine Room Heat",
   "blurb": "Smoke and honey bring furnace warmth to a story that keeps diving from roof tops to ice to Santa's workshop."
  },
  {
   "id": "bees-knees",
   "name": "Silver Bell Spark",
   "blurb": "Honey and lemon ring brighter than doubt, especially once that silver bell finally answers back."
  }
 ],
 "cuts": []
