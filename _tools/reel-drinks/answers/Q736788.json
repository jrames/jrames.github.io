 "signatures": [],
 "picks": [
  {
   "id": "bourbon-collins",
   "name": "Two Days to Thanksgiving",
   "blurb": "Bourbon and soda, tall and steady, for a man with one job: be in Chicago in time for dinner."
  },
  {
   "id": "moscow-mule",
   "name": "Diverted to Wichita",
   "blurb": "Ginger beer with a kick, for a flight that was supposed to land in Chicago and set down in Kansas instead."
  },
  {
   "id": "whiskey-sour",
   "name": "Shower Curtain Rings",
   "blurb": "Whiskey, lemon and a little sugar, for a salesman who never stops talking and never stops being kind."
  },
  {
   "id": "paloma",
   "name": "No Car in the Space",
   "blurb": "Grapefruit and salt, sharp enough for a man who has walked the whole lot and found no car in his space."
  },
  {
   "id": "cuba-libre",
   "name": "Wrong Side of the Highway",
   "blurb": "Rum and cola, cheap and cheerful, for the road trip where the car catches fire and they keep driving anyway."
  },
  {
   "id": "french-75",
   "name": "Before Anything Went Wrong",
   "blurb": "Gin and bubbles for a Manhattan ad man in a good suit, two days before Thanksgiving, before anything goes wrong."
  },
  {
   "id": "pimms-cup",
   "name": "Still Trying to Be Polite",
   "blurb": "Fruit, cucumber and good manners, for the first hour of a trip when Neal is still being polite about all of it."
  },
  {
   "id": "tom-collins",
   "name": "Broken-Down Train",
   "blurb": "Gin, lemon and soda, plain and patient, for a train that quits somewhere in Missouri and leaves everyone walking."
  },
  {
   "id": "brandy-rickey",
   "name": "Snowbound Roadside",
   "blurb": "Brandy with lime warms the sort of night when the highway looks longer than the map admits."
  },
  {
   "id": "bellini",
   "name": "One More Chair at Dinner",
   "blurb": "Peach and bubbles for the last scene, when the long way home ends at a full table with one more chair."
  },
  {
   "id": "greyhound",
   "name": "Terminal Coffee Shop",
   "blurb": "Grapefruit keeps this vodka highball brisk, like a diner booth at 6 a.m. before the next gate."
  },
  {
   "id": "suffering-bastard",
   "name": "Bus to St. Louis",
   "blurb": "Brandy, gin and ginger beer, rowdy and a little much, like your seatmate on the bus to St. Louis."
  },
  {
   "id": "canchanchara",
   "name": "Cold Motel Stop",
   "blurb": "Honeyed rum takes the edge off a night when the room heater sounds happier than you do."
  },
  {
   "id": "clover-club",
   "name": "Ticket Counter Blush",
   "blurb": "Raspberry makes the gin bright and a little embarrassed, which is handy after one more travel mishap."
  },
  {
   "id": "long-island-ice-tea",
   "name": "Last Leg Detour",
   "blurb": "This crowded pour is for the final stretch, when the map gets messy and nobody’s keeping score."
  }
 ],
