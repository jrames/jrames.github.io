 "picks": [
  {
   "id": "egg-nog",
   "name": "General Waverly's Pour",
   "blurb": "Eggs and brandy keep the cold Vermont setbacks from turning into a full holiday mutiny."
  },
  {
   "id": "hot-brandy-sling",
   "name": "Columbia Inn Hearth",
   "blurb": "This one brings the fireplace; brandy and hot water suit the empty inn better than any crowd would."
  },
  {
   "id": "mulled-claret",
   "name": "Pine Tree Service",
   "blurb": "Red wine and mulling spice warm the dead-silent Vermont lobby while the snow still refuses to show up."
  },
  {
   "id": "smoking-bishop",
   "name": "Christmas Eve Regiment",
   "blurb": "Port and citrus give the old soldiers' show a deeper red than any curtain in Pine Tree."
  },
  {
   "id": "french-75",
   "name": "Broadway Spotlights",
   "blurb": "Sparkling wine and gin keep the stage work crisp, bright, and just a little too polished for the snow delay."
  },
  {
   "id": "brandy-alexander",
   "name": "Wallace and Davis",
   "blurb": "Creamy brandy softens the edges, like two headliners trying not to notice they care about the same people."
  },
  {
   "id": "manhattan",
   "name": "Backstage Dressing Room",
   "blurb": "Rye and vermouth arrive with tuxedo discipline, which is exactly what a song-and-dance team needs after the last curtain."
  },
  {
   "id": "white-russian",
   "name": "Snowless Vermont Night",
   "blurb": "Vodka and cream look winter-white enough to fool the inn, even if the ground stays stubbornly bare."
  },
  {
   "id": "irish-coffee",
   "name": "Train Car Morning",
   "blurb": "Coffee and whiskey wake you up after a sleepless ride, especially when the sleeping compartment was someone else's problem."
  },
  {
   "id": "blood-and-sand",
   "name": "Florida Nightclub Curtain",
   "blurb": "Cherry, Scotch, and vermouth make the nightclub number feel dressed up and slightly melodramatic, like a touring act should."
  },
  {
   "id": "tom-collins",
   "name": "Columbia Inn Lobby",
   "blurb": "Gin and soda keep things brisk while everyone hustles through the empty hotel and its Christmas booking woes."
  },
  {
   "id": "whiskey-sour",
   "name": "Betty at the Desk",
   "blurb": "Lemon sharpens the sweetness the way Betty sharpens Bob's better instincts, whether he likes it or not."
  },
  {
   "id": "kir",
   "name": "Judy's Letter",
   "blurb": "Crème de cassis turns plain white wine pink, which is a fair trick for the sister who wrote the note."
  },
  {
   "id": "ramos-fizz",
   "name": "Haynes Sisters Harmony",
   "blurb": "Foam, citrus, and orange flower water are as fussy and decorative as a polished sister act in midcentury style."
  },
  {
   "id": "bourbon-and-ginger-ale",
   "name": "Vermont Rehearsal Break",
   "blurb": "Bourbon and ginger ale keep the pace easy between dance steps, which helps when the barn dance needs saving."
  }
