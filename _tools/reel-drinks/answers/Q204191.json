 "picks": [
  {
   "id": "irish-coffee",
   "name": "Bedford Falls Eve",
   "blurb": "Hot coffee and cream warm George's Christmas Eve into something less hopeless after that bar stool night."
  },
  {
   "id": "hot-brandy-sling",
   "name": "Clarence's Wing Plan",
   "blurb": "Brandy and hot water make a steady little rescue for a town that spends the night deciding what George means."
  },
  {
   "id": "whiskey-sour",
   "name": "Potter's Office Exit",
   "blurb": "Lemon sharpens the bourbon just enough for George's angry walk away from Potter's office."
  },
  {
   "id": "manhattan",
   "name": "Building and Loan",
   "blurb": "Rye and vermouth bring a grown-up edge to Bedford Falls, where every careful sacrifice lands with a thud."
  },
  {
   "id": "old-fashioned",
   "name": "Bailey House Hearth",
   "blurb": "Bourbon, sugar, and bitters keep this one old-school, like the Bailey family holding the whole place together."
  },
  {
   "id": "rob-roy",
   "name": "Christmas Eve Audit",
   "blurb": "Scotch and sweet vermouth stay composed while the bank examiner, the missing cash, and the panic close in."
  },
  {
   "id": "bourbon-and-ginger-ale",
   "name": "Snow on Main Street",
   "blurb": "Ginger ale gives the bourbon some lift, the way Bedford Falls keeps going under all that winter fuss."
  },
  {
   "id": "black-manhattan",
   "name": "Potter's Ledger",
   "blurb": "Amaro's bitterness suits Potter's office, where George's worst hour gets measured in money and cold words."
  },
  {
   "id": "tom-and-jerry",
   "name": "Christmas Eve Window",
   "blurb": "That hot batter and rum come out like a kitchen on a snowy night, all light and sweetness around the edges."
  },
  {
   "id": "new-york-sour",
   "name": "Train to New York",
   "blurb": "Red wine floats over the whiskey like a reminder of the life George once meant to chase beyond Bedford Falls."
  },
  {
   "id": "brandy-crusta",
   "name": "Mary Hatch Porch",
   "blurb": "Brandy and bright citrus feel right for the old neighborhood where George and Mary keep circling back."
  },
  {
   "id": "sazerac",
   "name": "Clarence's Lesson",
   "blurb": "Rye, absinthe, and bitters give the story a little old-world magic when heaven starts working on George."
  },
  {
   "id": "rusty-nail",
   "name": "Frozen Pond Memory",
   "blurb": "Scotch and Drambuie carry a wintry burn, like the film's sharpest childhood memory drifting through Christmas Eve."
  },
  {
   "id": "vodka-martini",
   "name": "Bedford Falls After Dark",
   "blurb": "This one stays stripped down and clear, which is useful when the night has already gone sideways."
  },
  {
   "id": "boothby",
   "name": "George Bailey Evening",
   "blurb": "Sparkling wine on top keeps the rye from getting too solemn, because even Bedford Falls deserves a little lift."
  }
